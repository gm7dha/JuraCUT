{
  "name": "JuraCUT",
  "short_name": "JuraCUT",
  "description": "Free, open-source laser design and cutting. Draw, import and lay out pieces for the Bambu Lab R1 and export SVG or DXF for Bambu Studio.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f6f8",
  "theme_color": "#1f6fd1",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "favicon.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "application/x-juracut+json": [".juracut"] } }
  ]
}
